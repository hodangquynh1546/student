# Copy to .env for local development. Replace every CHANGE_ME value before production.
APP_NAME=EduTrack
APP_ENV=development
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080
FRONTEND_PORT=5173
DB_HOST=postgres
DB_PORT=5432
DB_NAME=edutrack
DB_USERNAME=edutrack_user
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@edutrack.local
ADMIN_INITIAL_PASSWORD=CHANGE_ME_WITH_16_CHARACTERS
ADMIN_NAME=Giáo viên
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@edutrack.local
SMTP_ENABLED=true
SMTP_AUTH=false
SMTP_STARTTLS=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=60
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=/app/uploads
FILE_MAX_SIZE_MB=10
LOG_LEVEL=INFO
# Render frontend container only: http://<backend-internal-host>:8080
# BACKEND_UPSTREAM=
